  EXCEPTION_BLOCK
	STD_EXCEPTION_HANDLER;
  END_PROCEDURE;
*/
/*********************************************
* The constructor
*********************************************/
begin
  xInitialized := FALSE;
  xTable := null;
  xColumn := null;
  xParent := null;

  -- Last statement to be executed
  xInitialized := true;
EXCEPTION
  	STD_EXCEPTION_HANDLER;
END_CREATE_PACKAGE_BODY;
