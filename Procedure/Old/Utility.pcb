  -------------------------------------------------------
  -- Support function
  -------------------------------------------------------
  PROCEDURE(getColInfo)(lStr varchar2,lType out varchar2,lLength out number, lScale out number,lNull out boolean) 
  is
    lRBrac integer := 0;
    lLBrac integer := 0;
    lComma integer := 0;
    lSpace integer := 0;
    lStartNull integer := 0;
  begin
     if (lStr is null) then 
        USERERROR(11,'incoming string to decode');
     end if;
     
     lScale := 0;
     lNull := true;
     lLength := 0;
     lType := null;

     lStartNull := instr(lStr,'NOT NULL',-1);
     if (lStartNull > 0) then
         lNull := false;
     else
        lNull := true;
        lStartNull := instr(lStr,'NULL',-1);     
     end if;

     -------------------------------------------------------------------
     -- If there is a left bracket, pick up size and scale if present. Scale
     -- is present if a comma exists within left/right bracket.
     -- If no bracket: if there was no null/not null (identified by the
     -- lStartNull being equal to zero(0)), the entire string is the type.
     -- otherwise the type ends 2 positions prior to lStartNull (recall there
     -- is a space before the null/not null).
     -------------------------------------------------------------------
     lLBrac := instr(lStr,'(');
     if (lLBrac > 0) then
         lRBrac := instr(lStr,')');
         lComma := instr(lStr,',');

         lType := substr(lStr,1,lLBrac - 1);
         if (lComma = 0) then
            lLength := substr(lStr,lLBrac+1,lRBrac - (lLBrac+1));
         else   
            lLength := substr(lStr,lLBrac+1,lComma - (lLBrac+1));
            lScale := substr(lStr,lComma+1,lRBrac - (lComma+1));
         end if;
      else 
   		if (lStartNull = 0) then
	   	   lType := lStr;
		   else
            lType := substr(lStr,1,lStartNull - 2);
   		end if;
      end if;
  EXCEPTION
      THROW_EXCEPTION_HANDLER;
  END_FUNCTION; 
  
