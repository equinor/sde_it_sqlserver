/*****************************************************************
* Sorting routines.
*****************************************************************/
   PROCEDURE(qsort)(lList in out nocopy type_SortList,lLow0 integer,lHigh0 integer)
   is
     lLow integer;
     lHigh integer;
     lTemp integer;
     lMid integer;
     lIndex integer;
   begin
/*      xIteration := xIteration + 1;
      if (xIteration > xMaxIteration) then
         SYSTEMERROR('Max number of iterations <'||xMaxIteration||'> exceeded');
      end if;
*/
      DEBUG('In qsort low = <'||lLow0||'> and high = <'||lHigh0||'>');
   	lLow := lLow0;
   	lHigh := lHigh0;

   	if (lLow >= lHigh) then
   	    return;
   	end if ;
   
      lIndex := floor((lLow + lHigh) / 2);
   	lMid := lList(lIndex);
      DEBUG('lMid('||lIndex||') = <'||lMid||'>');

   	while (lLow < lHigh) 
   	loop
         while (lLow < lHigh and lList(lLow) < lMid) 
   		loop
            lLow := lLow + 1;
         end loop;
   
   	   while (lLow < lHigh and lList(lHigh) > lMid)
   		loop
   		   lHigh := lHigh - 1;
   	   end loop;
   
   	   if (lLow < lHigh) then
    		   lTemp := lList(lLow);
   		   lList(lLow) := lList(lHigh);
   		   lList(lHigh) := lTemp;
            lLow := lLow + 1;
            lHigh := lHigh - 1;
   	   end if;
   	end loop;
   
   	if (lHigh < lLow) then
   	    lTemp := lHigh;
   	    lHigh := lLow;
   	    lLow := lTemp;
   	end if;
   
   	qsort(lList, lLow0, lLow);
   
   	if (lLow = lLow0) then
         DEBUG('  Using lLow +1');
         qsort(lList, lLow+1, lHigh0);
   	else
         DEBUG('  Using lLow');
   	   qsort(lList, lLow, lHigh0);
   	end if;
   END_PROCEDURE;

   PROCEDURE(sort)(lList in out nocopy type_SortList,sortType integer default USE_QSORT)
   is
      lLow0 integer;
      lHigh0 integer;
   begin
      xIteration := 0;
      case
         when (sortType = USE_QSORT) then
            lLow0 := lList.first;
            lHigh0 := lList.last;
            DEBUG('In sort low = <'||lLow0||'> and high = <'||lHigh0||'>');
            qsort(lList,lLow0,lHigh0);
         else
            USERERROR(20,'Unknown sort type ('||sortType||')');
      end case;
   EXCEPTION_BLOCK
      STD_EXCEPTION_HANDLER;
   END_PROCEDURE;

   PROCEDURE(testSort)
   is
      lLow0 integer;
      lHigh0 integer;
      lList type_SortList := type_SortList(1,6,2,9,44,23,12,67,4,124,5,6,77,1,6,2,9,44,23,12,67,4,124,5,6,77,1,6,2,9,44,23,12,67,4,124,5,6,77,1,6,2,9,44,23,12,67,4,124,5,6,77,1,6,2,9,44,23,12,67,4,124,5,6,77,1,6,2,9,44,23,12,67,4,124,5,6,77,1,6,2,9,44,23,12,67,4,124,5,6,77);
      PROCEDURE(display)(lStr varchar2,lList type_SortList)
      is
      begin
         DEBUG(lStr);
         for i in lList.first..lList.last
         loop
            null;
            DEBUG('lList('||i||') = <'||lList(i)||'>');
         end loop;
         DEBUG('Nr of interations : '||xIteration);
      END_PROCEDURE;
   begin
      errorHandler.setLevel(errorHandler.level_trace);
      display('Unsorted list',lList);
      lLow0 := lList.first;
      lHigh0 := lList.last;
      sort(lList);      
      DEBUG('Low(0) = '||lLow0);
      DEBUG('lHigh(0) = '||lHigh0);
      display('Sorted list',lList);
   END_PROCEDURE;
   
/*********************************************
* The constructor
*********************************************/
begin
  xInitialized := false;
  xMetaChar := '^$.*+?\';

  ---------------------------------------
  -- For use with sorting,
  ---------------------------------------
  xInitialized := FALSE;
  xMaxIteration := 2000;
  USE_QSORT := 1;

  ---------------------------------------
  -- Identify the database
  ---------------------------------------
  xDatabase := FRAMEWORK_SCHEMA.Utility.getDatabaseName;

  /*
  if (xDatabase != FRAMEWORK_SCHEMA.IT_Constant.xDBProd
     and xDatabase != FRAMEWORK_SCHEMA.IT_Constant.xDBTest
     and xDatabase != FRAMEWORK_SCHEMA.IT_Constant.xDBDev
     ) 
  then
     USERERROR(20,'Failed to identify database: <'|| xDatabase ||'>');
  end if;
*/
  -- Last statement to be executed
  xInitialized := true;
EXCEPTION
  	THROW_EXCEPTION_HANDLER;
END_CREATE_PACKAGE_BODY;
