/*****************************************************************
* Pragma
*****************************************************************/
  bufferTooSmall exception;
  pragma exception_init(bufferTooSmall, -6502);  

/*****************************************************************
* Constants
*****************************************************************/
  xActual constant varchar2(20) := 'ACTUAL';

/*****************************************************************
* Variable - initialize variables in the constructor.
* xInitialized   indicates whether package is initialized or not
* xSql   string used for executing sql immediately or in cursors.
* xMetaChar metacharacters as recognized in regexp
*****************************************************************/
  type cur_type is ref cursor;

  xInitialized boolean;
  xSql varchar2(2000);
  xMetaChar varchar2(20);

  xMaxIteration integer;
  xIteration integer;

  xBufferOverflowStr varchar2(100) := 'Failed to append buffer overflow: ';

  xDatabase varchar2(50) := 'NA';

/*****************************************************************
* Standard methods
*****************************************************************/
  STD_PACKAGE_METHOD;

/*****************************************************************
* Init : Initializes the package
* Init is called by the constructor.
*****************************************************************/
  FUNCTION(isInitialized)
    return boolean
  is
  begin
    MCR_RETURN(xInitialized);
  END_FUNCTION;

  /***************************************************************
  * Bitwise functions
  * bitand - is a standard function in Oracle
  ***************************************************************/
  FUNCTION(bitor)( x in number, y in number ) return number  as
  begin
    return x + y - bitand(x,y);
  END_FUNCTION;

  FUNCTION(bitxor)( x in number, y in number ) return number  as
  begin
    return bitor(x,y) - bitand(x,y);
  END_FUNCTION;


  /***************************************************************
  * Executes the statement
  ***************************************************************/
  PROCEDURE(executeStatement)(lSql varchar2)
  is
  begin
     if (lSql is null) then
         USERERROR(11,'sql statement');
     end if;

DEBUG('SQL: '||lSql);
     execute immediate lSql;
  EXCEPTION
      THROW_EXCEPTION_HANDLER;
  END_PROCEDURE; 

/***************************************************************
* Checks if instance exists. 
* Remember to fully qualify the entity in question.
***************************************************************/
   FUNCTION(keyExist)(
          lEntity varchar2
         ,lSuidName varchar2
         ,lSuid SUID_TYPE
         )
     return boolean
   is
      lStatus boolean := false;
      lSql varchar2(2000);
      lCount integer;
   begin
     if (lEntity is null or lSuidName is null or lSuid is null) then
      SYSTEMERROR(11,'lEntity: <'|| lEntity ||'> lSuidName: <'|| lSuidName ||'> lSuid: <'|| lSuid ||'>');
    end if;      
     ----------------------------------------------
     -- Check existence of the entity
     ----------------------------------------------
    lSql := 'select count(*) from ' || lEntity
      || ' where ' || lSuidName || ' = :lSuid';

    execute immediate lSql into lCount using lSuid;
    if (lCount > 0) then
       lStatus := true;
    end if;

    MCR_RETURN(lStatus);
   EXCEPTION_BLOCK
      THROW_EXCEPTION_HANDLER;
   END_FUNCTION;

  /***************************************************************
  * Append to further details. Builds up the string which is to 
  * go into column 94 Further Details. Restricted to the length of
  * the column. Error message produced if length is exceeded.
  *
  * Should the need arise to ensure only one occurrence of the new 
  * string exists in the concatenated string, use REGEXP_INSTR 
  * function in Oracle.
  ***************************************************************/
  PROCEDURE(append)(lColumn in out varchar2,lStr varchar2)
  is
  begin
    lColumn := lColumn || lStr;
  EXCEPTION_BLOCK
     when bufferTooSmall then 
--         lColumn :=  xBufferOverflowStr||substr(lColumn,1,length(lColumn)-length(xBufferOverflowStr));
      USERERROR(20,xBufferOverflowStr||'<'||lStr||'> original str <'||lColumn||'>');
     when others then
      USERERROR(20,'Concatination failed <'||lStr||'> original str <'||lColumn||'>');
  END_PROCEDURE;

  PROCEDURE(appendToList)(lColumn in out varchar2,lStr varchar2,lSeparator varchar2 default ',')
  is
  begin
    if (lColumn is null or length(ltrim(rtrim(lColumn))) = 0) then
      lColumn := lStr;
    else
      lColumn := lColumn||lSeparator||lStr;
    end if;
  EXCEPTION_BLOCK
     when bufferTooSmall then 
--         lColumn :=  xBufferOverflowStr||substr(lColumn,1,length(lColumn)-length(xBufferOverflowStr));
      USERERROR(20,xBufferOverflowStr||'<'||lStr||'> original str <'||lColumn||'>');
     when others then
   	USERERROR(20,'Concatination failed <'||lStr||'> original str <'||lColumn||'>');
  END_PROCEDURE;

  PROCEDURE(appendToUniqueList)(lColumn in out varchar2,lStr varchar2,lSeparator varchar2 default ',')
  is
    lSep varchar2(10);
  begin
    if (lColumn is null or length(ltrim(rtrim(lColumn))) = 0) then
      lColumn := lStr;
    else
      lSep := lSeparator;

      if (length(lSep) = 1) then
         if (instr(xMetaChar,lSep) > 0) then
            lSep := '\'||lSeparator;
         end if;
      end if;

/*
      if (regexp_instr(lColumn,'(' ||
                    lSep||lStr|| '$' ||   -- handles the end
               '|^' ||lStr||'$'||         -- handle the first and only occurrence
               '|^' ||lStr||lSep||        -- handles the when first
               '|'  ||lSep||lStr||lSep||  -- handles when not start nor end
               ')' 
          ) = 0) then
        lColumn := lColumn||lSeparator||lStr;
      end if;
*/
lColumn := ''; -- must fix this procedure
    end if;
  EXCEPTION_BLOCK
     when bufferTooSmall then 
      USERERROR(20,xBufferOverflowStr||'<'||lStr||'> original str <'||lColumn||'>');
     when others then
   	USERERROR(20,'Concatination failed <'||lStr||'> original str <'||lColumn||'>');
  END_PROCEDURE;

  /***************************************************************
  * Conversion function
  * Status : OK
  ***************************************************************/
  FUNCTION(convertMetreToFeet)(lLength number)
    return number
  is
  begin
     return lLength/0.3048;
  END_FUNCTION;

  FUNCTION(convertFeetToMetre)(lLength number)
    return number
  is
  begin
     return lLength*0.3048;
  END_FUNCTION;

  -- Convert g/cm2 to PSI, 1 psi = 7.0309 x 10-2 kg/cm2
--xxx is this correct
  FUNCTION(convertGPrCMToPSI)(lPressure number)
    return number
  is
  begin
     return lPressure * 10000/7.0309;
  END_FUNCTION;

  FUNCTION(convertCelsiusToFahrenheit)(lTemp number)
    return number
  is
  begin
     return 32+(9*lTemp)/5;
  END_FUNCTION;

  FUNCTION(convertFahrenheitToCelsius)(lTemp number)
    return number
  is
  begin
     return (lTemp - 32)*5/9;
  END_FUNCTION;
 	
   FUNCTION(strToNumber)(lStrNum varchar2)
     return number
   is
     lStr varchar2(50);
     lPos integer := 0;
     lNum number := 0;
   begin
     -----------------------------------------------------------------
     -- Trim the string and if no content return.
     -----------------------------------------------------------------
     lStr := ltrim(rtrim(lStrNum));
     if (lStr is null or length(lStr) = 0) then
       MCR_RETURN(null);
     end if;

     -----------------------------------------------------------------
     -- Converts the following strings to number
     -- 3 3/4  search for a space, split and calculate
     -- 3,75   substitute the comma with decimal point and calculate
     -- 3.75   normal conversion
     -----------------------------------------------------------------
     lPos := instr(lStr,' ',-1);
     if (lPos > 0) then
       lNum := to_number(substr(lStr,1,lPos - 1));
       lStr := substr(lStr,lPos+1);
       lPos := instr(lStr,'/');
       lNum := lNum + to_number(substr(lStr,1,lPos-1)) / to_number(substr(lStr,lPos+1));
	 else
       lPos := instr(lStr,',',-1);
       if (lPos > 0) then
  	      lStr := translate(lStrNum,',','.'); 
         lNum := to_number(lStr);
       else
         lNum := to_number(lStr);
	    end if;
     end if;

     MCR_RETURN(lNum);
  END_FUNCTION;

  /***********************************************************
  * Checks the timestamp to see if any changes have been made
  * to the row.
  * Paremeters:
  * lEntity - the entity in focus
  * lKey  - the column name of the unique key (a suid)
  * lSuid - the suid value
  * lTimestamp - the timestamp value to be verified
  ***********************************************************/
  FUNCTION(hasChanged)(lEntity varchar2,lKey varchar2,lSuid SUID_TYPE,lTimestamp TIMESTAMP_TYPE)
    return boolean
  is
    lCount integer := 0;
    lSql varchar2(1000);
  begin
      if (lSuid is null) then SYSTEMERROR(11,'suid');
      elsif (lEntity is null) then SYSTEMERROR(11,'entity');
      elsif (lKey is null) then SYSTEMERROR(11,'key value');
      elsif (lTimestamp is null) then SYSTEMERROR(11,'timestamp');
      end if;

      lSql := 'select count(''x'')'
         || ' from ' || lEntity ||' ent'
         || ' where ent.' || lKey ||' = :lSuid'
         || ' and ent.time_stamp = :lTimestamp';

DEBUG('Sql: '||lSql);
     execute immediate lSql into lCount using lSuid,lTimestamp;

     if (lCount = 0) then
         MCR_RETURN(true);
     end if;

     MCR_RETURN(false);
  EXCEPTION
    THROW_EXCEPTION_HANDLER;
  END_FUNCTION;

/******************************************************
* Deletes an entity
* Example usage:
* To delete a particular well
*   lEntity => 'well'
*   lSuidName => 'well_s'
*   lSuid => 6640
*   lTimeStamp => 3245
* This will delete the well identified by suid = lSuid
* as long as the timestamp has not been modified.
******************************************************/
  PROCEDURE(deleteEntity)(
          lEntity varchar2
         ,lSuidName varchar2
         ,lSuid SUID_TYPE
         ,lTimestamp TIMESTAMP_TYPE
         ,lRowcount out integer
         )
  is
  begin
     if (lEntity is null or length(lEntity) = 0) then
         USERERROR(11,'entity');
     elsif (lSuidName is null or length(lSuidName) = 0) then
         USERERROR(11,'suid name');
     elsif (lSuid is null) then
         USERERROR(11,lSuidName);
     elsif (lTimestamp is null) then
         USERERROR(11,'time_stamp');
     end if;

     if (FRAMEWORK_SCHEMA.Utility.hasChanged(lEntity,lSuidName,lSuid,lTimestamp)) then
       USERERROR(19,'delete',lEntity);
     end if;

     ----------------------------------------------
     -- Delete the entity
     ----------------------------------------------
    xSql := 'delete from ' || lEntity
      || ' where ' || lSuidName || ' = :lSuid'
      || ' and time_stamp = :lTimeStamp';

    execute immediate xSql using lSuid,lTimeStamp;
    lRowcount := sql%rowcount;
  EXCEPTION
    THROW_EXCEPTION_HANDLER;
  END_PROCEDURE;

