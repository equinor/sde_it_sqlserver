  FUNCTION(existColumn)(lSchema varchar2,lTable varchar2,lColumn varchar2)
    return boolean
  is
/*    cursor cur_info(lTable varchar2,lColumn varchar2)
      is select count('x')
         from dbr.r_table_def r
         where r.table_kind = 'TABLE'
         and r.table_name = lTable
         and r.column_name = lColumn;
*/
    lCount integer := 0;
  begin
      if (lSchema is null) then
         USERERROR(11,'schema');
      elsif (lTable is null) then
         USERERROR(11,'table');
      elsif (lColumn is null) then
         USERERROR(11,'column');
      end if;

/*      OPEN_CURSOR(cur_info)(lTable,lColumn);
      fetch cur_info into lCount;
      CLOSE_CURSOR(cur_info);
*/
      if (lCount = 0) then
         MCR_RETURN(false);
      end if;

      MCR_RETURN(true);
  EXCEPTION
      THROW_EXCEPTION_HANDLER;
  END_FUNCTION; 

  FUNCTION(existTable)(lSchema varchar2,lTable varchar2)
    return boolean
  is
/*    cursor cur_info(lTable varchar2)
      is select count('x')
         from dbr.r_table_def r
         where r.table_kind = 'TABLE'
         and r.table_name = lTable;
*/
    lCount integer := 0;
  begin
      if (lSchema is null) then
         USERERROR(11,'schema');
      elsif (lTable is null) then
         USERERROR(11,'table');
      end if;

/*      OPEN_CURSOR(cur_info)(lTable);
      fetch cur_info into lCount;
      CLOSE_CURSOR(cur_info);
*/
      if (lCount = 0) then
         MCR_RETURN(false);
      end if;

      MCR_RETURN(true);
  EXCEPTION
      THROW_EXCEPTION_HANDLER;
  END_FUNCTION; 


  PROCEDURE(loadSchema)(lSchema varchar2)
  is
    cursor cur_info
      is select * from user_tab_columns
      order by table_name,column_name;
  begin
    if (lSchema is null) then
      USERERROR(11,'schema');
    end if;

    if (lSchema != user) then
      USERERROR(20,'Schema <'||lSchema||'> must be the same as the user <'||user||'>');
    end if;

    USERERROR(20,'Not implemented');
  EXCEPTION
      THROW_EXCEPTION_HANDLER;
  END_FUNCTION; 

