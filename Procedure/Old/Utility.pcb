  /***************************************************************
  * Manipulates the indexes on the given table. One can disable the
  * indexes or rebuild them (which also enables them)
  * How to disable and later enable all table indexes in Oracle
  * (see http://stackoverflow.com/questions/129046/disable-and-later-enable-all-table-indexes-in-oracle)
  ***************************************************************/
  PROCEDURE(manipulateIndex)(lSchema varchar2,lTableName varchar2,lAction varchar2 default 'rebuild')
  is
    cursor lIndex (lSchema varchar2,lTableName varchar2)
     is select u.index_name
     from user_indexes u
     where table_name = lTableName ;

    lStr varchar2(100);
  begin
     if (lTableName is null) then
       USERERROR(11,'table_name');
     elsif (lAction = 'disable') then
       lStr := 'unusable';
     elsif (lAction = 'rebuild') then
       lStr := 'rebuild online';
     else
       USERERROR(20,'Legal values <disable> or <rebuild online>');
     end if;

     for i in lIndex(lSchema,lTableName)
     loop
       executeStatement('alter index '||i.index_name|| ' ' || lStr);
     end loop;
  EXCEPTION
    THROW_EXCEPTION_HANDLER;
  END_PROCEDURE;

  PROCEDURE(disableIndex)(lSchema varchar2,lTableName varchar2)
  is
  begin
      manipulateIndex(lSchema,lTableName,'disable');
  EXCEPTION
    THROW_EXCEPTION_HANDLER;
  END_PROCEDURE;

  PROCEDURE(rebuildIndex)(lSchema varchar2,lTableName varchar2)
  is
  begin
      manipulateIndex(lSchema,lTableName,'rebuild');
  EXCEPTION
    THROW_EXCEPTION_HANDLER;
  END_PROCEDURE;

  /***************************************************************
  * Truncates the table
  ***************************************************************/
  PROCEDURE(truncateTable)(lSchema varchar2,lTable varchar2)
  is 
  begin
     executeStatement('truncate table '||lSchema||'.'||lTable);
  EXCEPTION
    THROW_EXCEPTION_HANDLER;
  END_PROCEDURE;

  /***************************************************************
  * Checks if table exists
  ***************************************************************/
  FUNCTION(existTable)(lSchema varchar2, lTableName varchar2)
     return boolean
  is
     cursor curTable(lSchema varchar2, lTableName varchar2)
       is select count(*) as count
         from user_tables
         where table_name = lTableName;
      lCount integer := 0;
  begin
     for i in curTable(lSchema,lTableName)
     loop
         lCount := i.count;
         exit;
     end loop;
     if (lCount > 0) then
         MCR_RETURN(true);
     end if;    

     MCR_RETURN(false);
  EXCEPTION
      THROW_EXCEPTION_HANDLER;
  END_FUNCTION; 

  /***************************************************************
  * Create shadow table
  * Creates a shadow table and indexes. Contrainsts are not handled.
  ***************************************************************/
  PROCEDURE(createShadowTable)(lSchema varchar2,lTableName varchar2,lShadowTableName varchar2,lDrop boolean default false)
  is
    cursor curTable(lSchema varchar2,lTableName varchar2) is
      select t.table_name
         from user_tables t
         where t.table_name = lTableName;

    cursor curTableColumn(lSchema varchar2,lTableName varchar2) is
      select c.column_name
            ,c.data_type
            ,decode(data_type
                     ,'CHAR', char_length
                     ,'VARCHAR', char_length
                     ,'VARCHAR2', char_length
                     ,'NCHAR', char_length
                     ,'NVARCHAR', char_length
                     ,'NVARCHAR2', char_length
                    ) data_length
            ,c.data_precision
            ,decode(c.nullable
                     ,'N','NOT NULL'
                     ,'NULL') nullable
            ,c.column_id
            ,decode(c.data_type
               ,'VARCHAR2','VARCHAR2('||c.data_length||')'
               ,'CHAR','CHAR('||c.data_length||')'
               ,'NUMBER','NUMBER('||c.data_precision||decode(c.data_scale,'','',','||c.data_scale) ||  ')'
               ,c.data_type
               ) as strType
            ,c.data_default
         from user_tables t
             ,user_tab_columns c
         where t.table_name = lTableName
         and t.table_name = c.table_name
         order by c.TABLE_NAME, c.column_id;

    cursor curIndex(lSchema varchar2,lTableName varchar2,lShadowTable varchar2)
      is select 'create '||decode(uniqueness,'NONUNIQUE','','UNIQUE','UNIQUE')
            ||' index '||i.table_owner ||'.'|| i.index_name   --xxxxxxxxxx - use lShadowTable!!
            ||' on '||i.table_owner||'.'||i.table_name
            as text
           ,i.table_owner,i.table_name,i.index_name
      from user_indexes i
      where i.table_name = lTableName
      and i.table_owner = lSchema
      order by i.table_owner,i.table_name;

    cursor curIndexColumn(lSchema varchar2,lTableOwner varchar2,lTable varchar2,lIndex varchar2) is
      select c.column_name,c.descend,c.column_position
      from  user_ind_columns c
      where c.index_name = lIndex
      and c.table_name = lTable
      order by c.table_name,c.table_name,c.column_position;
    
    lStr varchar2(4000) := '';
    lSql varchar2(4000) := '';
    lTableSpace varchar2(100) := '';
    lCount integer := 1;
  begin
    ------------------------------------------------
    -- Create the table
    ------------------------------------------------
    if (lDrop) then
        lSql := 'drop table '|| lShadowTableName;
    end if;

    lSql := 'create table '|| lShadowTableName || '(';
    for i in curTableColumn(lSchema,lTableName)
    loop
       lStr := i.column_name || ' ' || i.strType;
       if (i.data_default is not null) then
           lStr := lStr || ' default ' || i.data_default;
       end if;
 
       lStr := lStr || ' ' || i.nullable;
       if ((length(lStr) + length(lSql)) > 1000) then
          lSql := lSql ||')';
          executeStatement(lSql);
          lSql := '';
          lSql := 'ALTER TABLE '|| lShadowTableName || ' add (';
          lCount := 1;
        end if;

        if (lCount > 1) then
           lStr := ','||lStr;
        end if;

        lSql := lSql || lStr;
        lCount := lCount + 1;
    end loop;

    if (lSql is not null) then
       lSql := lSql ||')';
       executeStatement(lSql);
    end if;

    ------------------------------------------------
    -- Create the table indexes
    ------------------------------------------------
    for i in curIndex(lSchema,lTableName,lShadowTableName)
    loop
      lSql := '';
      lSql := lSql||i.text||'(';
      for j in curIndexColumn(lSchema,i.Table_owner,i.table_name,i.index_name)
      loop
         if (j.column_position > 1) then
           lSql := lSql|| ',' ;
         end if;
        lSql := lSql||j.column_name || ' ' || j.descend;
      end loop;
      lSql := lSql||');';
      executeStatement(lSql);
    end loop;
  EXCEPTION
      THROW_EXCEPTION_HANDLER;
  END_PROCEDURE;

