CREATE_TRIGGER(SCHEMA.{table_name})
  on SCHEMA.{table_name}
  after insert, update,delete
as
/*****************************************************************
*  Package Info
*   Author          : $Author:  $
*   Original Date   : $Date: 2026-02-02 $
*   Last Modified   : $Modtime: $
*   Archive Name    : $Archive: $
*   Description     : $Header: 
*   Revision History: $Revision: 1.0 $
*   Tag name        : $Name:  $
*   Workfile        : $Workfile: $
*****************************************************************
* Description
* In T-SQL, this trigger is equivalent to Oracle after statement.
*
*****************************************************************
* Log
* Date   Description					 Done by
*
*****************************************************************/
begin
   if (rowcount_big() = 0)
      return;
   if TRIGGER_NESTLEVEL() > 1
      return
      
   set nocount on;
   STANDARD_VARIABLE;
   
   BEGIN_EXCEPTION
      if (IS_TRG_INSERTING) 
      begin
      end;

      if (IS_TRG_UPDATING) 
      begin
      end;

      if (IS_TRG_DELETING) 
      begin
      end;
   EXCEPTION
      STANDARD_EXCEPTION_HANDLER;
   END_EXCEPTION;
END_TRIGGER;
